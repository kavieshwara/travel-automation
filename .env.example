# Server
PORT=4173

# Booking/public contact configuration
# Use E.164 format without spaces, for example +919025929032
BUSINESS_WHATSAPP_NUMBER=+919025929032
BUSINESS_PHONE_NUMBER=+9104222443533
BUSINESS_EMAIL=info@karthiktravels.in
OWNER_WHATSAPP_NUMBER=+919025929032
OWNER_EMAIL=owner@example.com

# Provider: local, meta, twilio, or openwa
WHATSAPP_PROVIDER=local

# OpenWA local testing provider
OPENWA_API_BASE_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=dev-admin-key
OPENWA_SESSION_ID=replace-with-openwa-session-uuid
OPENWA_ENABLE_INTERACTIVE=true
OPENWA_OPTION_MODE=poll
OPENWA_SEND_TEXT_FALLBACK=true

# Meta WhatsApp Cloud API
# Never commit real values. Configure these in your deployment environment.
WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-token
META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=

# Twilio WhatsApp API fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email provider: local or resend
EMAIL_PROVIDER=local
EMAIL_FROM=Karthik Travels <bookings@example.com>
RESEND_API_KEY=
